{
  "progress": true,
  "datasets": [
    {
      "name": "led7",
      "path": "datasets/led7.txt",
      "max_pattern_size": 5,
      "max_candidates": 5000,
      "move_operations": ["add", "remove", "replace"]
    }
  ],
  "variants": [
    "unguided",
    "prior_only",
    "successful_feature",
    "good_solution_frequency",
    "mutation_feature"
  ],
  "seeds": [0, 1, 2],
  "search": {
    "iterations": 1000,
    "candidate_pool_size": 5,
    "temperature_start": 2.0,
    "temperature_end": 0.01,
    "elite_fraction": 0.25
  },
  "guidance": {
    "alpha": 0.1,
    "decay": 0.01,
    "prior": 1.0,
    "epsilon": 1e-9
  },
  "parallel": {
    "max_workers": 4
  }
}
